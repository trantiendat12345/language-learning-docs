# File thật (.env.production) tạo trực tiếp trên VM, KHÔNG commit. Copy file này rồi điền giá
# trị thật: cp .env.production.example .env.production
#
# docker-compose.yml đọc file này khi chạy `docker compose --env-file .env.production ...`

# Mật khẩu root MySQL (chỉ dùng nội bộ container, admin) - random mạnh, khác DB_PASSWORD.
MYSQL_ROOT_PASSWORD=

MYSQL_DATABASE=language_learning

# Tài khoản MySQL app dùng để kết nối (không phải root) - random mạnh.
DB_USERNAME=applang
DB_PASSWORD=

# Random mạnh, KHÁC giá trị đang dùng ở local dev (application-local.properties) - secret production
# không bao giờ trùng secret dev. Tạo bằng: openssl rand -base64 64
JWT_SECRET=
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# Domain thật (subdomain DuckDNS + HTTPS) - dùng cho CORS allowed-origin.
FRONTEND_URL=https://your-subdomain.duckdns.org
